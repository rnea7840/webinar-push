rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Settings: any authenticated user can read/write.
    // Lock further by configuring Firebase Auth → Authentication →
    // Sign-in method → restrict to specific Google emails / domains.
    match /settings/{doc} {
      allow read, write: if request.auth != null;
    }

    // Reads only for the dashboard. Writes happen exclusively from
    // Cloud Functions using the admin SDK (which bypasses these rules).
    match /prospects/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /sends/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /activity_log/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    match /linkedin_quota_usage/{doc} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Default: deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
